# Copy to .env and fill in. .env is gitignored.
BOT_TOKEN=your-discord-bot-token

# Optional: comma/space-separated guild IDs for instant command sync in dev.
# Leave empty for global registration (slower to propagate).
DEV_GUILD_IDS=

# Async SQLAlchemy connection URL (asyncpg driver).
DATABASE_URL=postgresql+asyncpg://user:pass@127.0.0.1:5432/coda

# Optional: comma/space-separated Discord user IDs allowed to run owner commands.
OWNER_IDS=

# Optional: guilds the owner terminal /run is created in. Empty falls back to
# DEV_GUILD_IDS; empty there too means /run exists in no guild at all.
OWNER_GUILD_IDS=

# Optional: the owner's own Arcaea friend code (9 digits). Reserved so only
# OWNER_IDS members can register it; anyone else is refused as impersonation.
# Leave empty to disable that guard.
OWNER_FRIEND_CODE=

# Fernet key encrypting stored Arcaea credentials (bot accounts and linked
# player accounts). Generate one with:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing this key orphans every encrypted row -- there is no rotation path.
FERNET_KEY=

# Optional: comma-separated YouTube links for the max-score (MPM) easter egg.
# One is picked at random per max score. Only youtube.com/youtu.be URLs are
# accepted -- anything else fails at startup. Leave empty to disable the link.
MAX_SCORE_URLS=

# Logging. All optional. Each output has its own threshold; a single log call can
# override its output with extra={"console"|"file"|"discord": True/False}.
# Console threshold (DEBUG/INFO/WARNING/ERROR/CRITICAL). Default INFO.
LOG_LEVEL=INFO
# Directory for log files. Created if missing. Unset = no file output.
# Each run writes its own file, named coda_<YYYY-MM-DD>_<HH-MM-SS>.log.
LOG_DIR=
# File threshold (only used when LOG_DIR is set). Default DEBUG.
LOG_FILE_LEVEL=DEBUG
# Channel ID for log embeds. Unset = no Discord logging.
# ⚠️ Use a PRIVATE, owner-only channel -- logs can carry operational detail and
# this is a wider audience than a local file.
LOG_DISCORD_CHANNEL_ID=
# Discord threshold (only used when LOG_DISCORD_CHANNEL_ID is set). Default WARNING.
LOG_DISCORD_LEVEL=WARNING
